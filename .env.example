# Copy this file to .env and fill in the keys you have.
# copy .env.example .env

# Key your own applications must send.
# Leave this blank while you are testing on this computer.
MIDDLEWARE_API_KEY=

# Claude. Required when type is claude and LLM_MODE is live.
ANTHROPIC_API_KEY=

# ChatGPT / OpenAI. Required when type is chatgpt and LLM_MODE is live.
OPENAI_API_KEY=

# Grok. Required when type is grok and LLM_MODE is live.
# Create a key at https://console.x.ai/
XAI_API_KEY=

# NVIDIA NIM. Required when type is nvidia and LLM_MODE is live.
# Create a key at https://build.nvidia.com/settings/api-keys
# The key starts with nvapi-
NVIDIA_API_KEY=

# Groq, not xAI Grok. Required when type is groq and LLM_MODE is live.
# Create a key at https://console.groq.com/keys
# The key starts with gsk_
GROQ_API_KEY=

# live = real Claude and ChatGPT answers.
# mock = fake answers, so you can test the API with no keys.
LLM_MODE=live

# Used when the caller sends "model": "auto"
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-5
OPENAI_DEFAULT_MODEL=gpt-4o-mini
GROK_DEFAULT_MODEL=grok-4.7
NVIDIA_DEFAULT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
OLLAMA_DEFAULT_MODEL=gemma4:31b

# Used when the caller sends "type": "auto" on /api/v1/chat
DEFAULT_PROVIDER=claude

ANTHROPIC_BASE_URL=https://api.anthropic.com
OPENAI_BASE_URL=https://api.openai.com/v1
XAI_BASE_URL=https://api.x.ai/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Online Ollama. Create a key at https://ollama.com/settings/keys
# For a local Ollama server, use http://127.0.0.1:11434/v1 and leave the key empty.
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_API_KEY=

# Image generation. type auto on /api/v1/images uses IMAGE_DEFAULT_PROVIDER.
IMAGE_DEFAULT_PROVIDER=grok
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
GROK_IMAGE_MODEL=grok-imagine-image-2.0
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-dev
NVIDIA_IMAGE_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-dev
NVIDIA_VIDEO_MODEL=nvidia/cosmos3-nano
NVIDIA_VIDEO_URL=https://ai.api.nvidia.com/v1/cosmos/nvidia/cosmos3-nano
NVIDIA_VIDEO_STATUS_URL=https://api.nvcf.nvidia.com/v2/nvcf/pexec/status
FREE_VIDEO_MODEL=Lightricks/ltx-video-distilled
FREE_VIDEO_URL=https://lightricks-ltx-video-distilled.hf.space
# Optional. A free token from https://huggingface.co/settings/tokens uses your own daily GPU minutes.
HUGGINGFACE_TOKEN=

# Higgsfield Seedance video. Set this to key_id:key_secret from the Higgsfield dashboard.
HF_CREDENTIALS=
HF_VIDEO_MODEL=bytedance/seedance-2.5/text-to-video
HF_BASE_URL=https://api.higgsfield.ai
OLLAMA_IMAGE_MODEL=x/z-image-turbo

# Google Gemini. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# AI Horde image generation. Create a key at https://aihorde.net/register
AIHORDE_API_KEY=
AIHORDE_IMAGE_MODEL=stable_diffusion
AIHORDE_BASE_URL=https://aihorde.net/api/v2
AIHORDE_WAIT_SECONDS=180

HOST=127.0.0.1
PORT=8080
CORS_ORIGINS=*
REQUEST_TIMEOUT_SECONDS=120
